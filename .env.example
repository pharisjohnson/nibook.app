# Monorepo Root Environment Variables
# Copy this file to .env and fill in your values
#
# Everything below is read by functions/api/[[path]].ts (Cloudflare Pages Functions),
# the only backend for this project. Set the same values as Cloudflare Pages env vars
# for production/preview deploys.

# Frontend (Vite) + API — InsForge project credentials
VITE_INSFORGE_URL=https://your-project-id.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# API-only — InsForge service-role key (falls back to VITE_INSFORGE_* above if unset)
INSFORGE_URL=https://your-project-id.us-east.insforge.app
INSFORGE_SERVICE_KEY=your_insforge_service_role_key_here

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Used for server-side transaction init, verify, and webhook validation
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# Paystack Plan Codes — create plans at https://dashboard.paystack.com/#/plans
# and paste the generated plan codes (format: PLN_xxxxxxxxxxxxxxxxx)
VITE_PAYSTACK_STARTER_PLAN_CODE=PLN_your_starter_plan_code
VITE_PAYSTACK_PREMIUM_PLAN_CODE=PLN_your_premium_plan_code

# PayHero (M-Pesa) — https://payhero.co.ke
PAYHERO_USERNAME=your_payhero_username
PAYHERO_PASSWORD=your_payhero_password
PAYHERO_CHANNEL_ID=your_payhero_channel_id
PAYHERO_CALLBACK_URL=https://your-production-domain.com/api/payments/callback
PAYHERO_AUTH_TOKEN=your_payhero_auth_token

# Public URL of this app (used to build payment callback/redirect URLs and email links)
APP_URL=https://your-production-domain.com

# Admin/cron — required headers for protected debug and sweep endpoints
ADMIN_SECRET_KEY=choose_a_long_random_value
TRIAL_SWEEP_KEY=choose_a_long_random_value
